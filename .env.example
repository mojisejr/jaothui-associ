# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.mjs"
# should be updated accordingly.

# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL database connection URL
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# =============================================================================
# NEXT.JS ENVIRONMENT
# =============================================================================
NODE_ENV="development"
PORT=3000


# Vercel deployment URL (automatically set by Vercel)
VERCEL_URL=

# =============================================================================
# SANITY CMS
# =============================================================================
NEXT_PUBLIC_SANITY_PROJECT_ID="your_sanity_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2023-10-31"
NEXT_PUBLIC_SANITY_TOKEN="your_sanity_token"

# =============================================================================
# SUPABASE
# =============================================================================
NEXT_PUBLIC_supabase_url="https://your-project.supabase.co"
NEXT_PUBLIC_supabase_key="your_supabase_anon_key"

# =============================================================================
# BLOCKCHAIN NETWORK
# =============================================================================
# Network type: "Testnet" or "Mainnet"
NEXT_PUBLIC_network="Testnet"

# =============================================================================
# NFT STORAGE / IPFS
# =============================================================================
NEXT_PUBLIC_nft_storage_key="your_nft_storage_api_key"

# =============================================================================
# BITKUB NEXT OAUTH
# =============================================================================
# Development credentials
NEXT_PUBLIC_client_id_dev="your_bitkub_client_id_dev"
NEXT_PUBLIC_redirect_dev="http://localhost:3000/oauth/callback"

# Production credentials
NEXT_PUBLIC_client_id_prod="your_bitkub_client_id_prod"
NEXT_PUBLIC_redirect_prod="https://your-domain.com/oauth/callback"

# Production environment flag
production="DEV"

# =============================================================================
# LINE NOTIFY
# =============================================================================
line_uri="https://notify-api.line.me/api/notify"
line="your_line_notify_token"
line_microchip_payment="your_line_microchip_payment_token"
line_certification_approvment="your_line_certification_approval_token"

# =============================================================================
# N8N WEBHOOKS
# =============================================================================
N8N_PAYMENT_NOTIFY_URL="https://your-n8n-instance.com/webhook/payment"
N8N_APPROVMENT_NOTIFY_URL="https://your-n8n-instance.com/webhook/approval"
N8N_NOTIFY_TOKEN="your_n8n_webhook_token"

# =============================================================================
# MINTER SERVICE
# =============================================================================
minter_url="https://your-minter-service.com/api"
bkey="your_bearer_token_for_minter"
